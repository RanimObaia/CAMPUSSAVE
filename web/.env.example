# Copy to .env.local and fill in. Firebase web config is public by design,
# but keep it out of git anyway so each developer uses their own project.
VITE_API_URL=http://localhost:4000/api

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Mode démonstration : true = données fictives, sans backend ni Firebase
VITE_USE_MOCK=false
