# Copy this file to .env and fill in the values. Never commit .env.

PORT=4000
# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Firebase Admin: path to the service-account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Passerelle de paiement : konnect (par défaut), stripe ou simulation
#   stripe     = vraie page de paiement Stripe en mode test (carte 4242 4242 4242 4242)
#   simulation = page de paiement de test intégrée, sans service extérieur
PAIEMENT_MODE=stripe

# Stripe (mode test) : dashboard.stripe.com > Développeurs > Clés API > clé secrète sk_test_...
STRIPE_SECRET_KEY=

# Konnect (sandbox = mode test, aucune vraie transaction)
# Adresse officielle (documentation Konnect) ; compte de test : https://dashboard.sandbox.konnect.network
# Production : https://api.konnect.network/api/v2
KONNECT_API_URL=https://api.preprod.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Public URLs used for payment redirects and webhook
BACKEND_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# Email (Nodemailer, Gmail app password)
MAIL_USER=
MAIL_APP_PASSWORD=
# Facultatif : reçoit une copie cachée de chaque email de confirmation (ex. pour la démo)
MAIL_COPIE=
# Facultatif : reçoit les messages du formulaire de contact (sinon MAIL_USER)
MAIL_CONTACT=
