# Copy this file to .env and fill in the values. Never commit .env.

PORT=4000
# Comma-separated list of allowed front-end origins
CORS_ORIGINS=http://localhost:5173

# Firebase Admin: path to the service-account JSON
# (Firebase console > Project settings > Service accounts > Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Konnect (sandbox)
KONNECT_API_URL=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=
KONNECT_WALLET_ID=

# Public URLs used for payment redirects and webhook
BACKEND_PUBLIC_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# Email (Nodemailer, Gmail app password)
MAIL_USER=
MAIL_APP_PASSWORD=
