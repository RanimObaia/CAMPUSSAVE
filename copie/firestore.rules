rules_version = '2';

// Règles de sécurité Firestore de CampusSave.
//
// Toutes les lectures et écritures passent par l'API (backend Node.js / Express),
// qui vérifie le jeton Firebase et le rôle (student, merchant, admin) avant chaque action.
// Le backend utilise le SDK Admin, qui n'est pas concerné par ces règles.
//
// Les applications Web et Mobile n'ont donc AUCUN accès direct à la base :
// impossible de modifier un prix, un stock ou le statut d'une commande
// sans passer par les contrôles du serveur.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
