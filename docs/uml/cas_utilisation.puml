@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam ranksep 35
skinparam nodesep 20
skinparam usecase {
  BackgroundColor #F5FAF2
  BorderColor #2E7D32
}
skinparam actorStyle awesome

actor "Utilisateur" as USR
actor "Étudiant" as ETU
actor "Commerçant" as COM
actor "Administrateur" as ADM
actor "Passerelle de paiement\n(Konnect)" as KON <<système>>

rectangle "Plateforme CampusSave" {

  usecase "S'authentifier\n(inscription, connexion,\ndéconnexion)" as AUTH
  usecase "Gérer son profil" as PRO

  package "Espace Étudiant" as PE {
    usecase "Consulter les offres" as CONS
    usecase "Rechercher une offre\n(produit, commerce,\ncatégorie, prix)" as REC
    usecase "Choisir des produits\net les quantités" as CHOIX
    usecase "Gérer le panier\n(+/- quantité, total)" as PAN
    usecase "Réserver / valider\nla commande" as RES
    usecase "Payer en ligne" as PAY
    usecase "Recevoir le QR code" as QR
    usecase "Suivre ses commandes" as SUIVI
    usecase "Tableau de bord\nétudiant" as DBE
  }

  package "Espace Commerçant" as PC {
    usecase "Inscrire son commerce" as COMINS
    usecase "Gérer les informations\ndu commerce" as COMINFO
    usecase "Publier une offre" as PUB
    usecase "Modifier une offre" as MOD
    usecase "Supprimer une offre" as SUP
    usecase "Traiter les commandes" as TRAIT
    usecase "Valider le QR code\nà la récupération" as VAL
    usecase "Tableau de bord\ncommerçant" as DBC
  }

  package "Espace Administrateur" as PA {
    usecase "Valider / refuser\nun commerçant" as VC
    usecase "Gérer les utilisateurs" as GU
    usecase "Superviser la plateforme\n(tableau de bord)" as DBA
  }
}

' --- Généralisation des acteurs ---
USR <|-- ETU
USR <|-- COM
USR <|-- ADM

USR --> AUTH
USR --> PRO

' --- Étudiant ---
ETU --> CONS
ETU --> PAN
ETU --> RES
ETU --> PAY
ETU --> SUIVI
ETU --> DBE

' --- Commerçant ---
COM --> COMINS
COM --> COMINFO
COM --> PUB
COM --> MOD
COM --> SUP
COM --> TRAIT
COM --> VAL
COM --> DBC

' --- Administrateur ---
ADM --> VC
ADM --> GU
ADM --> DBA

' --- Relations entre cas ---
REC ..> CONS : <<extend>>
PAN ..> CHOIX : <<include>>
RES ..> PAN : <<include>>
PAY ..> RES : <<include>>
PAY ..> QR : <<include>>
VAL ..> QR : <<include>>
PUB ..> COMINFO : <<include>>
COMINS ..> VC : <<include>>

PAY --> KON
@enduml
